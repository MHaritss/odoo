<odoo>
    <template id="report_smk_kwitansi_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="print_date" t-value="print_date or '-'"/>
                <t t-set="print_time" t-value="print_time or '-'"/>
                <t t-set="teacher_names" t-value="', '.join(doc.teacher_ids.mapped('name')) or '-'"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row align-items-center mb-3">
                            <div class="col-auto">
                                <img t-if="doc.env.company.logo"
                                     t-att-src="image_data_uri(doc.env.company.logo)"
                                     alt="Company Logo"
                                     style="max-height:60px;"/>
                                <img t-else=""
                                     src="/web/static/src/img/logo.png"
                                     alt="Company Logo"
                                     style="max-height:60px;"/>
                            </div>
                            <div class="col">
                                <h2 class="mb-1">SMK Karanganyar</h2>
                                <p class="mb-0 text-muted" style="font-size:11px;">
                                    Jl. Lawu, Hartosari, Popongan, Karanganyar, Jawa Tengah<br/>
                                    Telp. 0271-494-787 | Web: www.smkpenda2.sch.id | Email: info@smkpenda2.sch.id
                                </p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 text-center">
                                <h3 class="mt-2 mb-3">Bukti Pembayaran Siswa</h3>
                            </div>
                        </div>

                        <table class="table table-sm mb-4">
                            <tbody>
                                <tr>
                                    <td class="w-25">No Trans</td>
                                    <td class="w-25">: <span t-field="doc.name"/></td>
                                    <td class="w-25">NIS</td>
                                    <td class="w-25">: <span t-esc="doc.student_id.nis or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Tanggal</td>
                                    <td>: <span t-field="doc.date_invoice"/></td>
                                    <td>Nama Siswa</td>
                                    <td>: <span t-esc="doc.student_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Jam Cetak</td>
                                    <td>: <span t-esc="print_time"/></td>
                                    <td>Kelas</td>
                                    <td>: <span t-esc="doc.kelas_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Guru Pengajar</td>
                                    <td colspan="3">: <span t-esc="teacher_names"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center w-10">No.</th>
                                    <th>Keterangan Pembayaran</th>
                                    <th class="text-end w-25">Jumlah (Rp)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">1</td>
                                    <td><span t-esc="doc.description or 'Pembayaran biaya pendidikan'"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.amount" widget="monetary" options="{'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Grand Total :</th>
                                    <th class="text-end">
                                        <span t-field="doc.amount" widget="monetary" options="{'display_currency': doc.currency_id}"/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="mb-3">
                            <strong>Terbilang :</strong>
                            <span class="font-italic ml-1" t-esc="doc._amount_to_text_id() or ''"/>
                        </div>

                        <div class="mb-4">
                            <strong>Catatan :</strong>
                            <ul class="mb-0">
                                <li>Disimpan sebagai bukti pembayaran yang sah.</li>
                                <li>Uang yang sudah dibayarkan tidak dapat diminta kembali.</li>
                            </ul>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Mengetahui,</p>
                                <p><span t-esc="doc.env.company.name"/></p>
                            </div>
                            <div class="col-6 text-end">
                                <p>Karanganyar, <span t-esc="print_date"/></p>
                                <p>Yang Menerima,</p>
                                <div style="margin-top:60px; font-weight:600;">Widiya Nanda Gardhea Putri, S.Pd.</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
